{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/delivery",
      "destination": "/api/admin?view=delivery"
    },
    {
      "source": "/takeaway",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "public/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}